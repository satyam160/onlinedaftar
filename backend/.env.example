# Copy this file to .env and fill in your real values. Never commit .env to git.

PORT=4000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/onlinedaftar

# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST mode keys (rzp_test_...) until you complete Razorpay KYC for live mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Used to sign login sessions — generate any long random string
JWT_SECRET=change_this_to_a_long_random_string

# Your frontend URL, for CORS. Use * while testing locally from a file://
# page (double-clicked HTML file) — tighten this to your real domain once
# you deploy for real.
FRONTEND_URL=*

# --- Email OTP (optional — leave blank to just log codes to console in dev) ---
# Works with any SMTP provider. Easiest free options: Gmail (with an App
# Password, not your real password), Brevo, or Resend's SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OnlineDaftar <noreply@onlinedaftar.com>

# --- SMS OTP (optional — leave blank to just log codes to console in dev) ---
# Sign up at https://www.twilio.com or an India-focused alternative like
# https://msg91.com (often cheaper for Indian numbers). Fill these in and
# uncomment the Twilio code block in routes/otp.js, or swap in your
# provider's SDK following the same pattern.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
